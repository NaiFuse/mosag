---
const links = [
 { href: '/leistungen/', label: 'Leistungen' },
 { href: '/ueber-uns/', label: 'Über uns' },
 { href: '/einsatzgebiet/', label: 'Einsatzgebiet' },
 { href: '/kontakt/', label: 'Kontakt' }
];
const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(href);
---
<header class="site-header">
 <div class="container header-inner">
  <a class="brand" href="/" aria-label="MOSAG Gebäudeservice – Startseite">
   <img class="brand-dark" src="/images/mosag-logo.png" alt="MOSAG Logo" width="800" height="328" />
   <img class="brand-light" src="/images/mosag-logo-light.png" alt="" aria-hidden="true" width="800" height="328" />
  </a>
  <nav class="nav-desktop" aria-label="Hauptnavigation">
   {links.map(l => <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>)}
  </nav>
  <a class="btn btn-primary header-cta" href="/kontakt/"><span class="btn-label">Angebot anfragen</span></a>
  <details class="nav-mobile">
   <summary aria-label="Menü öffnen"><span class="burger" aria-hidden="true"></span><span>Menü</span></summary>
   <nav aria-label="Hauptnavigation (mobil)">
    {links.map(l => <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>)}
    <a class="btn btn-primary" href="/kontakt/"><span class="btn-label">Angebot anfragen</span></a>
   </nav>
  </details>
 </div>
</header>
<script>
 const header = document.querySelector<HTMLElement>('.site-header');
 const hero = document.querySelector<HTMLElement>('.hero');
 if (header) {
  const update = () => {
   const h = header.offsetHeight;
   const overHero = !!hero && hero.getBoundingClientRect().bottom > h;
   header.classList.toggle('on-dark', overHero);
   header.classList.toggle('is-scrolled', !overHero && window.scrollY > 0);
  };
  update();
  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update);
 }
</script>
