---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '@fontsource-variable/inter';
import '../styles/global.css';
const {title='Professioneller Gebäudeservice im Rhein-Main-Gebiet',description='MOSAG Gebäudeservice aus Darmstadt: Unterhaltsreinigung, Treppenhausreinigung, Fensterreinigung, Winterdienst, Hausmeisterservice und Sonderreinigung.',overlayHeader=false}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site);
---
<!doctype html><html lang="de"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#F8F7F5"/><meta name="description" content={description}/><meta property="og:type" content="website"/><meta property="og:title" content={title+' | MOSAG'}/><meta property="og:description" content={description}/><meta property="og:image" content="/images/mosag-original.png"/><link rel="canonical" href={canonical}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><title>{title} | MOSAG</title></head><body><a class="skip-link" href="#inhalt">Zum Inhalt springen</a><Header overlay={overlayHeader}/><main id="inhalt"><slot/></main><Footer/></body></html>
