---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '@fontsource-variable/inter';
import '../styles/global.css';
const {title='Professioneller Gebäudeservice im Rhein-Main-Gebiet',description='MOSAG Gebäudeservice aus Darmstadt: Unterhaltsreinigung, Treppenhausreinigung, Fensterreinigung, Winterdienst, Hausmeisterservice und Sonderreinigung.'}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site);
---
<!doctype html><html lang="de"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#F8F7F5"/><meta name="description" content={description}/><meta property="og:type" content="website"/><meta property="og:title" content={title+' | MOSAG'}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:site_name" content="MOSAG Gebäudeservice"/><meta property="og:locale" content="de_DE"/><meta property="og:image" content={new URL('/images/mosag-share.jpg',Astro.site)}/><meta property="og:image:type" content="image/jpeg"/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content="MOSAG Gebäudeservice Darmstadt – Logo"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:image" content={new URL('/images/mosag-share.jpg',Astro.site)}/><link rel="canonical" href={canonical}/><link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/><title>{title} | MOSAG</title></head><body><a class="skip-link" href="#inhalt">Zum Inhalt springen</a><Header/><main id="inhalt"><slot/></main><Footer/></body></html>
