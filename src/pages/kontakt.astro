---
import Base from '../layouts/Base.astro';import {site} from '../data/site';import ContactForm from '../components/ContactForm.astro';
---
<Base title="Beste Gebäudereinigung in Darmstadt – Kontakt & Angebot anfragen bei MOSAG Gebäudeservice" description="Kontakt zu MOSAG Gebäudeservice in Darmstadt: Sprechen Sie direkt mit Geschäftsführer Mohamed El Yassini – telefonisch unter 0172 3103033 oder über das Kontaktformular."><section class="page-hero"><div class="container"><p class="eyebrow">KONTAKT</p><h1>Ein gutes Ergebnis<br/><em>beginnt mit einem Gespräch.</em><span class="h1-sub">Kontakt zu MOSAG Gebäudeservice in Darmstadt</span></h1><p>Schildern Sie uns Ihren Bedarf – wir freuen uns auf Ihre Anfrage.</p></div></section><section class="section"><div class="container contact-grid"><div class="contact-details"><p class="eyebrow">DIREKT ERREICHBAR</p><h2>Wir sind für Sie da.</h2><div class="contact-item"><span>TELEFON</span><a href={'tel:'+site.phoneHref}>{site.phoneDisplay}</a></div><div class="contact-item"><span>E-MAIL</span><a href={'mailto:'+site.email}>{site.email}</a></div><div class="contact-item"><span>ANSPRECHPARTNER</span><strong>{site.contactName}</strong></div><div class="contact-item"><span>STANDORT</span><strong>{site.street}<br/>{site.zipCity}</strong></div></div><div class="form-shell"><h2>Angebot anfragen</h2><p>Bitte füllen Sie die Felder aus. Pflichtfelder sind mit * markiert.</p><ContactForm/></div></div></section></Base>
