---
import Base from '../layouts/Base.astro';import CTA from '../components/CTA.astro';import {towns} from '../data/site';
const pages = Object.keys(import.meta.glob('../data/orte/*.md')).map(p=>p.split('/').pop()!.replace(/\.md$/,''));
---
<Base title="Beste Gebäudereinigung in Darmstadt – Einsatzgebiet Darmstadt & Rhein-Main-Gebiet: Gebäudeservice in Ihrer Nähe" description="Gebäudereinigung in Darmstadt und im Rhein-Main-Gebiet: MOSAG betreut Objekte in 26 Orten – von Weiterstadt über Frankfurt bis Wiesbaden und Hanau. Ihren Ort finden."><section class="page-hero"><div class="container"><p class="eyebrow">REGIONAL VERBUNDEN</p><h1>In Darmstadt zuhause.<br/><em>Im Rhein-Main-Gebiet im Einsatz.</em></h1><p>Wir betreuen gewerbliche Anfragen aus der Region – der konkrete Einsatzort wird individuell abgestimmt.</p></div></section><section class="section"><div class="container split"><div><p class="eyebrow">UNSERE REGION</p><h2>Kurze Wege. Klare Kommunikation.</h2></div><div class="prose"><p>Unser Unternehmensstandort ist Darmstadt. Zum Rhein-Main-Gebiet zählen unter anderem Frankfurt am Main, Offenbach, Wiesbaden und Mainz.</p><p>Ob Ihr Objekt in unserem aktuellen Einsatzradius liegt, klären wir gerne direkt mit Ihnen. Eine Anfrage ist unverbindlich.</p><a class="button button-primary" href="/kontakt/"><span class="btn-label">Einsatzort anfragen</span> <span aria-hidden="true">↗</span></a></div></div></section>
<section class="section section-tight-top" aria-labelledby="orte-title"><div class="container"><p class="eyebrow">ORTE IM EINSATZGEBIET</p><h2 id="orte-title">Gebäudereinigung in Ihrer Nähe</h2><ul class="town-list">{towns.map(t=><li>{pages.includes(t.slug) ? <a href={`/einsatzgebiet/${t.slug}/`}>Gebäudereinigung {t.name}</a> : <span>{t.name}</span>}<small>ca. {t.km} km</small></li>)}</ul></div></section>
<CTA/></Base>
