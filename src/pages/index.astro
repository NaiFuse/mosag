---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import {services,site} from '../data/site';
---
<Base title="Gebäudereinigung für Unternehmen in Darmstadt & Rhein-Main"><section class="hero"><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow">GEWERBLICHE GEBÄUDEREINIGUNG · RHEIN-MAIN</p><h1>Saubere Räume.<br/><em>Starker Eindruck.</em></h1><p class="hero-lead">MOSAG steht für zuverlässige Reinigung und Gebäudeservice für Unternehmen, Hausverwaltungen und Gewerbeimmobilien – persönlich betreut aus Darmstadt.</p><div class="hero-actions"><a class="button button-primary" href="/kontakt/">Jetzt Angebot anfordern <span aria-hidden="true">↗</span></a><a class="text-link" href="/leistungen/">Leistungen entdecken <span aria-hidden="true">→</span></a></div><div class="hero-meta"><span>01 / Persönlicher Ansprechpartner</span><span>02 / Individuelle Lösungen</span><span>03 / Rhein-Main-Gebiet</span></div></div><div class="hero-art"><div class="art-frame"><img src="/images/mosag-original.png" alt="Originales MOSAG-Logo mit Darmstädter Fünffingerturm" width="809" height="391"/><div class="art-caption">MO'S SAUBERER AUTHENTISCHER GEBÄUDESERVICE</div></div><div class="hero-tag">AUS DARMSTADT<br/><strong>FÜR RHEIN-MAIN</strong></div></div></div></section>
<section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">WAS WIR FÜR SIE TUN</p><h2>Unsere Leistungen<span class="dot">.</span></h2></div><p>Durchdachte Gebäudedienstleistungen für den gewerblichen Alltag – abgestimmt auf Ihre Immobilie.</p></div><div class="service-grid">{services.map((s,i)=><a class="service-card" href={'/leistungen/'+s.slug+'/'}><span class="service-index">0{i+1}</span><span class="service-icon" aria-hidden="true">{s.icon}</span><h3>{s.name}</h3><p>{s.teaser}</p><span class="service-arrow" aria-hidden="true">↗</span></a>)}</div></div></section>
<section class="section section-muted"><div class="container split"><div><p class="eyebrow">WARUM MOSAG</p><h2>Gebäudeservice mit <em>klarem Anspruch.</em></h2></div><div class="value-list"><div><span>01</span><div><h3>Persönlich erreichbar</h3><p>Ein direkter Ansprechpartner für Ihre Fragen und Anforderungen.</p></div></div><div><span>02</span><div><h3>Passend zu Ihrem Objekt</h3><p>Leistungsumfang und Reinigungsrhythmus werden individuell besprochen.</p></div></div><div><span>03</span><div><h3>Regional verbunden</h3><p>Unser Standort in Darmstadt – für gewerbliche Kunden im Rhein-Main-Gebiet.</p></div></div></div></div></section>
<section class="section"><div class="container region-strip"><div><p class="eyebrow">UNSER EINSATZGEBIET</p><h2>Darmstadt ist unser Ausgangspunkt.<br/><em>Rhein-Main unser Einsatzgebiet.</em></h2></div><a class="text-link" href="/einsatzgebiet/">Mehr erfahren <span aria-hidden="true">→</span></a></div></section><CTA/></Base>
