---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import ContactForm from '../components/ContactForm.astro';
import {services,site,photos} from '../data/site';

const reasons = [
 { n: '01', title: 'Direkt vor Ort', text: 'Wir sind in Ihrer Nähe und betreuen Unternehmen im gesamten Rhein-Main-Gebiet.' },
 { n: '02', title: 'Immer sauber', text: 'Mal gründlich, mal halbherzig? Gibt’s bei uns nicht. Sie bekommen die gleiche gründliche Reinigung. Immer.' },
 { n: '03', title: 'Direkt erreichbar', text: '„Da muss ich erst den Kollegen fragen.“ hören Sie bei uns nicht. Sie sprechen direkt mit der Geschäftsführung.' }
];
---
<Base title="Gebäudereinigung für Unternehmen in Darmstadt & Rhein-Main">

 <!-- Hero -->
 <section class="hero" aria-labelledby="hero-title">
    <Photo photo={photos.hero} class="hero-media" eager dark />
    <div class="container hero-content">
     <p class="hero-kicker">Gebäudeservice aus {site.zipCity.replace(/^\d+\s/,'')} · {site.region}</p>
     <h1 id="hero-title">Gebäudeservice in Darmstadt</h1>
     <div class="hero-bottom">
      <p class="hero-lead">Zuverlässige Gebäudereinigung und Gebäudeservice für Unternehmen, Hausverwaltungen und Gewerbeimmobilien – persönlich betreut.</p>
      <div class="btn-group">
       <a class="btn btn-primary btn-lg" href="#kontakt">Angebot anfordern</a>
       <a class="btn btn-secondary btn-lg" href="#leistungen">Leistungen ansehen</a>
      </div>
     </div>
    </div>
 </section>

 <!-- Einleitung -->
 <section class="section">
  <div class="container">
   <p class="statement">Suchen Sie einen Gebäudeservice, dem Sie <span class="accent">nicht hinterherlaufen müssen</span>?</p>
  </div>
 </section>

 <!-- Leistungen -->
 <section class="section section-tight-top" id="leistungen" aria-labelledby="leistungen-title">
  <div class="container">
   <div class="section-head">
    <h2 id="leistungen-title"><span class="accent">Was</span> machen wir?</h2>
   </div>
   <div class="card-grid">
    {services.map(s=>(
     <a class="service-card" href={'/leistungen/'+s.slug+'/'}>
      <h3>{s.name}</h3>
      <span class="card-link">Mehr erfahren <span aria-hidden="true">→</span></span>
     </a>
    ))}
   </div>
  </div>
 </section>

 <!-- Warum wir -->
 <section class="section section-muted" aria-labelledby="warum-title">
  <div class="container">
   <div class="section-head">
    <h2 id="warum-title"><span class="accent">Warum</span> wir?</h2>
   </div>
   <ol class="reasons">
    {reasons.map(r=>(
     <li class="reason">
      <span class="reason-n" aria-hidden="true">{r.n}</span>
      <h3>{r.title}</h3>
      <p>{r.text}</p>
     </li>
    ))}
   </ol>
  </div>
 </section>

 <!-- Kontakt -->
 <section class="section" id="kontakt" aria-labelledby="kontakt-title">
  <div class="container contact-home">
   <div class="contact-cta">
    <h2 id="kontakt-title">Ihr Objekt. <br/>Unser Anspruch.</h2>
    <p>Beschreiben Sie uns Ihren Bedarf – wir melden uns mit einem unverbindlichen Angebot.</p>
    <ul class="contact-lines">
     <li><span>Telefon</span><a href={'tel:'+site.phoneHref}>{site.phoneDisplay}</a></li>
     <li><span>E-Mail</span><a href={'mailto:'+site.email}>{site.email}</a></li>
     <li><span>Standort</span><strong>{site.street}, {site.zipCity}</strong></li>
    </ul>
   </div>
   <div class="form-card">
    <h3>Angebot anfragen</h3>
    <ContactForm id="kontaktformular-start" />
   </div>
  </div>
 </section>
</Base>
