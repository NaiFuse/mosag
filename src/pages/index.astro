---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import ContactForm from '../components/ContactForm.astro';
import {services,site,photos,serviceLabels} from '../data/site';

const steps = [
 { n: '01', title: 'Anfrage', text: 'Sie schildern uns Objekt, gewünschte Leistung und Intervalle – per Formular, E-Mail oder Telefon.' },
 { n: '02', title: 'Besichtigung & Angebot', text: 'Wir klären die Anforderungen vor Ort oder im Gespräch und erstellen ein individuelles, transparentes Angebot.' },
 { n: '03', title: 'Zuverlässige Ausführung', text: 'Die vereinbarten Leistungen werden regelmäßig umgesetzt – mit einem festen Ansprechpartner für Rückfragen.' }
];
const stats = [
 { value: String(services.length), label: 'Leistungsbereiche aus einer Hand' },
 { value: '1', label: 'Persönlicher Ansprechpartner' },
 { value: 'Darmstadt', label: 'Unser Unternehmensstandort' },
 { value: 'Rhein-Main', label: 'Unser Einsatzgebiet' }
];
const values = [
 { title: 'Persönlich erreichbar', text: 'Ein direkter Ansprechpartner für Ihre Fragen, Wünsche und Anpassungen.' },
 { title: 'Passend zu Ihrem Objekt', text: 'Leistungsumfang und Reinigungsrhythmus werden individuell mit Ihnen abgestimmt.' },
 { title: 'Regional verbunden', text: 'Aus Darmstadt für gewerbliche Kunden im gesamten Rhein-Main-Gebiet.' }
];
---
<Base title="Gebäudereinigung für Unternehmen in Darmstadt & Rhein-Main">

 <!-- Hero -->
 <section class="hero" aria-labelledby="hero-title">
    <Photo photo={photos.hero} class="hero-media" eager dark />
    <div class="container hero-content">
     <p class="hero-kicker">Gebäudeservice aus {site.zipCity.replace(/^\d+\s/,'')} · {site.region}</p>
     <h1 id="hero-title">Saubere Räume.<br/>Starker Eindruck.</h1>
     <div class="hero-bottom">
      <p class="hero-lead">Zuverlässige Gebäudereinigung und Gebäudeservice für Unternehmen, Hausverwaltungen und Gewerbeimmobilien – persönlich betreut.</p>
      <div class="btn-group">
       <a class="btn btn-primary btn-lg" href="#kontakt">Angebot anfordern</a>
       <a class="btn btn-secondary btn-lg" href="#leistungen">Leistungen ansehen</a>
      </div>
     </div>
    </div>
 </section>

 <!-- Einleitung -->
 <section class="section">
  <div class="container">
   <p class="statement">MOSAG steht für Gebäudeservice, der im Alltag funktioniert: <span class="accent">gründlich, verlässlich und persönlich</span> – damit Ihre Räume jeden Tag einen guten Eindruck hinterlassen.</p>
  </div>
 </section>

 <!-- Leistungen -->
 <section class="section section-tight-top" id="leistungen" aria-labelledby="leistungen-title">
  <div class="container">
   <div class="section-head">
    <h2 id="leistungen-title">Unsere <span class="accent">Leistungen</span></h2>
    <p>Durchdachte Gebäudedienstleistungen für den gewerblichen Alltag – abgestimmt auf Ihre Immobilie.</p>
   </div>
   <div class="card-grid">
    {services.map(s=>(
     <a class="service-card" href={'/leistungen/'+s.slug+'/'}>
      <span class="card-label">{serviceLabels[s.slug]}</span>
      <Photo photo={photos[s.slug]} class="card-media" />
      <h3>{s.name}</h3>
      <p>{s.teaser}</p>
      <span class="card-link">Mehr erfahren <span aria-hidden="true">→</span></span>
     </a>
    ))}
   </div>
  </div>
 </section>

 <!-- Ablauf -->
 <section class="section section-muted" aria-labelledby="ablauf-title">
  <div class="container two-col">
   <div>
    <h2 id="ablauf-title">In drei Schritten zu <span class="accent">sauberen Räumen</span></h2>
    <ol class="steps">
     {steps.map(st=>(
      <li><span class="step-n">{st.n}</span><div><h3>{st.title}</h3><p>{st.text}</p></div></li>
     ))}
    </ol>
    <a class="btn btn-primary" href="#kontakt">Jetzt anfragen</a>
   </div>
   <Photo photo={photos.process} class="tall-media" />
  </div>
 </section>

 <!-- Über uns -->
 <section class="section" aria-labelledby="about-title">
  <div class="container about">
   <div class="gallery">
    <Photo photo={photos.about1} class="g1" />
    <Photo photo={photos.about2} class="g2" />
    <Photo photo={photos.about3} class="g3" />
   </div>
   <div class="about-copy">
    <h2 id="about-title">Gebäudeservice <span class="accent">aus Darmstadt</span></h2>
    <p>MOSAG – {site.fullName} – bietet Reinigungs- und Gebäudedienstleistungen für gewerbliche Kunden im {site.region} an.</p>
    <p>Im Mittelpunkt stehen eine klare Abstimmung, persönliche Erreichbarkeit und Leistungen, die zum jeweiligen Objekt passen. Ihr Ansprechpartner: <strong>{site.contactName}</strong>.</p>
    <a class="btn btn-secondary btn-outline" href="/ueber-uns/">Mehr über uns</a>
   </div>
  </div>
 </section>

 <!-- Kennzahlen (nur belegbare Fakten) -->
 <section class="section section-tight-top" aria-label="MOSAG in Zahlen und Fakten">
  <div class="container">
   <ul class="stats">
    {stats.map(st=><li><span class="stat-value">{st.value}</span><span class="stat-label">{st.label}</span></li>)}
   </ul>
  </div>
 </section>

 <!-- Werte -->
 <section class="section section-muted" aria-labelledby="werte-title">
  <div class="container values">
   <div class="values-copy">
    <h2 id="werte-title">Wofür <span class="accent">wir stehen</span></h2>
    <div class="value-cards">
     {values.map(v=><article class="value-card"><h3>{v.title}</h3><p>{v.text}</p></article>)}
    </div>
   </div>
   <Photo photo={photos.values} class="tall-media" />
  </div>
 </section>

 <!-- Kontakt -->
 <section class="section" id="kontakt" aria-labelledby="kontakt-title">
  <div class="container contact-home">
   <div class="contact-cta">
    <h2 id="kontakt-title">Ihr Objekt. <br/>Unser Anspruch.</h2>
    <p>Beschreiben Sie uns Ihren Bedarf – wir melden uns mit einem unverbindlichen Angebot.</p>
    <ul class="contact-lines">
     <li><span>Telefon</span><a href={'tel:'+site.phoneHref}>{site.phoneDisplay}</a></li>
     <li><span>E-Mail</span><a href={'mailto:'+site.email}>{site.email}</a></li>
     <li><span>Standort</span><strong>{site.street}, {site.zipCity}</strong></li>
    </ul>
   </div>
   <div class="form-card">
    <h3>Angebot anfragen</h3>
    <ContactForm id="kontaktformular-start" />
   </div>
  </div>
 </section>
</Base>
