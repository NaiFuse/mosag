---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import {services,site,photos,towns} from '../data/site';
const orte = Object.keys(import.meta.glob('../data/orte/*.md')).map(p=>p.split('/').pop()!.replace(/\.md$/,''));
const nearby = towns.filter(t=>orte.includes(t.slug)).slice(0,8);

const reasons = [
 { n: '01', title: 'Direkt vor Ort', text: 'Wir sind in Ihrer Nähe und betreuen Unternehmen im gesamten Rhein-Main-Gebiet.' },
 { n: '02', title: 'Immer sauber', text: 'Mal gründlich, mal halbherzig? Gibt’s bei uns nicht. Sie bekommen die gleiche gründliche Reinigung. Immer.' },
 { n: '03', title: 'Direkt erreichbar', text: '„Da muss ich erst den Kollegen fragen.“ hören Sie bei uns nicht. Sie sprechen direkt mit der Geschäftsführung.' }
];
---
<Base title="Beste Gebäudereinigung in Darmstadt – Unterhaltsreinigung, Treppenhausreinigung, Fensterreinigung, Winterdienst & Hausmeisterservice in Ihrer Nähe" description="Gebäudereinigung in Darmstadt für Unternehmen und Hausverwaltungen: Büro-, Treppenhaus- und Fensterreinigung, Winterdienst & Hausmeisterservice. Preis in 2 Minuten anfragen.">

 <!-- Hero -->
 <section class="hero" aria-labelledby="hero-title">
    <Photo photo={photos.hero} class="hero-media" eager dark />
    <div class="container hero-content">
     <p class="hero-kicker">Gebäudeservice aus {site.zipCity.replace(/^\d+\s/,'')} · {site.region}</p>
     <h1 id="hero-title">Gebäudeservice in Darmstadt</h1>
     <div class="hero-bottom">
      <p class="hero-lead">Zuverlässige Gebäudereinigung und Gebäudeservice für Unternehmen, Hausverwaltungen und Gewerbeimmobilien – persönlich betreut.</p>
      <div class="btn-group">
       <a class="btn btn-secondary btn-lg hero-cta" href="/apply/"><span class="btn-label">Wie viel kostet das?</span></a>
      </div>
     </div>
    </div>
 </section>
 {photos.hero.credit && <p class="container hero-credit"><a href={photos.hero.creditHref} target="_blank" rel="noopener">{photos.hero.credit}</a></p>}

 <!-- Einleitung -->
 <section class="section">
  <div class="container">
   <p class="statement">Suchen Sie einen Gebäudeservice, dem Sie <span class="accent">nicht hinterherlaufen müssen</span>?</p>
  </div>
 </section>

 <!-- Leistungen -->
 <section class="section section-tight-top" id="leistungen" aria-labelledby="leistungen-title">
  <div class="container">
   <div class="section-head">
    <h2 id="leistungen-title"><span class="accent">Was</span> machen wir?</h2>
   </div>
   <div class="card-grid">
    {services.map(s=>(
     <a class="service-card" href={'/leistungen/'+s.slug+'/'}>
      <Photo photo={photos[s.slug]} class="card-photo" />
      <h3>{s.name}</h3>
      <span class="card-link">Mehr erfahren <span aria-hidden="true">→</span></span>
     </a>
    ))}
   </div>
   <p class="more-link-wrap"><a class="text-link" href="/leistungen/">Was macht ihr noch?</a></p>
  </div>
 </section>

 <!-- Warum wir -->
 <section class="section section-muted" aria-labelledby="warum-title">
  <div class="container">
   <div class="section-head">
    <h2 id="warum-title"><span class="accent">Warum</span> wir?</h2>
   </div>
   <ol class="reasons">
    {reasons.map(r=>(
     <li class="reason">
      <span class="reason-n" aria-hidden="true">{r.n}</span>
      <h3>{r.title}</h3>
      <p>{r.text}</p>
     </li>
    ))}
   </ol>
  </div>
 </section>


 <!-- Einsatzgebiet -->
 <section class="section" aria-labelledby="region-title">
  <div class="container">
   <div class="section-head">
    <h2 id="region-title">Gebäudereinigung in Darmstadt <span class="accent">und Umgebung</span></h2>
   </div>
   <div class="service-article">
    <p>MOSAG ist ein inhabergeführter Gebäudeservice mit Sitz in der Moltkestraße 10 in Darmstadt. Wir reinigen und betreuen Büros, Treppenhäuser, Gewerbeimmobilien und öffentliche Einrichtungen – für Unternehmen, Hausverwaltungen und Eigentümer. Umfang, Intervalle und Einsatzzeiten legen wir für jedes Objekt einzeln fest und halten sie im Angebot fest.</p>
    <p>Hinter MOSAG steht Mohamed El Yassini. Seit September 2023 ist er Hausmeister am Hochzeitsturm, dem Fünffingerturm auf der Mathildenhöhe. Mit derselben Sorgfalt betreut er Ihr Objekt, und Sie sprechen immer direkt mit ihm. <a href="/ueber-uns/">Mehr über MOSAG und unsere Geschichte</a>.</p>
    <p>Von Darmstadt aus sind wir im gesamten <a href="/einsatzgebiet/">Einsatzgebiet im Rhein-Main-Gebiet</a> unterwegs, zum Beispiel in diesen Orten:</p>
   </div>
   <ul class="town-list">{nearby.map(t=><li><a href={`/einsatzgebiet/${t.slug}/`}>Gebäudereinigung {t.name}</a><small>ca. {t.km} km</small></li>)}</ul>
  </div>
 </section>

 <!-- Preis-CTA -->
 <section class="section section-price" id="kontakt" aria-labelledby="preis-title">
  <div class="container">
   <div class="price-cta">
    <h2 id="preis-title"><span class="accent">Wie viel</span> kostet mich das?</h2>
    <p>Schauen Sie sich an, wie viel es kostet, konkret Ihr Objekt zu reinigen.</p>
    <a class="btn btn-primary btn-xl" href="/apply/"><span class="btn-label">Preise ansehen</span></a>
   </div>
  </div>
 </section>
</Base>
