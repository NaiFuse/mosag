---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import {services} from '../../data/site';
export function getStaticPaths(){return services.map(service=>({params:{slug:service.slug},props:{service}}));}
const {service}=Astro.props;
// Ausführlicher Leistungstext, falls vorhanden: src/data/articles/<slug>.md
const articles = import.meta.glob<{frontmatter:{h1?:string;description?:string};Content:any}>('../../data/articles/*.md',{eager:true});
const article = articles[`../../data/articles/${service.slug}.md`];
const Content = article?.Content;
---
{article ? (
<Base title={service.seoTitle} description={article.frontmatter.description ?? service.intro} schema={[{'@type':'Service','@id':new URL(`/leistungen/${service.slug}/#service`,Astro.site).href,name:service.name,serviceType:service.name,url:new URL(`/leistungen/${service.slug}/`,Astro.site).href,areaServed:{'@type':'Place',name:'Darmstadt und Rhein-Main-Gebiet'}}]}>
 <section class="page-hero"><div class="container"><p class="eyebrow"><a href="/leistungen/">LEISTUNGEN</a> / {service.name.toUpperCase()}</p><h1 class="h1-long">{article.frontmatter.h1 ?? service.name}</h1><p>{service.teaser}</p></div></section>
 <section class="section"><div class="container"><article class="service-article"><Content/></article></div></section>
 <CTA/>
</Base>
) : (
<Base title={service.seoTitle} description={service.intro} schema={[{'@type':'Service','@id':new URL(`/leistungen/${service.slug}/#service`,Astro.site).href,name:service.name,serviceType:service.name,url:new URL(`/leistungen/${service.slug}/`,Astro.site).href,areaServed:{'@type':'Place',name:'Darmstadt und Rhein-Main-Gebiet'}}]}><section class="page-hero"><div class="container"><p class="eyebrow"><a href="/leistungen/">LEISTUNGEN</a> / {service.name.toUpperCase()}</p><h1>{service.name}<span class="dot">.</span></h1><p>{service.teaser}</p></div></section><section class="section"><div class="container detail-grid"><div><p class="eyebrow">UNSER LEISTUNGSBEREICH</p><h2>Auf Ihre Anforderungen abgestimmt.</h2><p class="detail-lead">{service.intro}</p><p>Wir besprechen den konkreten Umfang, die gewünschten Intervalle und die Besonderheiten Ihres Objekts individuell mit Ihnen.</p><a class="button button-primary" href={'/apply/?leistung='+service.slug}><span class="btn-label">Unverbindlich anfragen</span> <span aria-hidden="true">↗</span></a></div><aside class="detail-panel"><span class="detail-symbol" aria-hidden="true">{service.icon}</span><h3>Mögliche Leistungsbestandteile</h3><ul>{service.items.map(item=><li>{item}</li>)}</ul><p class="fineprint">Der konkrete Leistungsumfang ergibt sich aus dem individuell vereinbarten Angebot.</p></aside></div></section><CTA/></Base>
)}
